{
  "extends": ["github>freecodecamp/renovate-config"],
  "docker-compose": {
    "managerFilePatterns": ["/stacks/.+/stack-.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "ansible-galaxy gives github-tags the full git URL, but github-tags needs owner/repo. Remove the host and the .git suffix.",
      "matchManagers": ["ansible-galaxy"],
      "matchDatasources": ["github-tags"],
      "overridePackageName": "{{{replace '^(?:git\\+)?https://github\\.com/|\\.git$' '' packageName}}}"
    }
  ]
}
