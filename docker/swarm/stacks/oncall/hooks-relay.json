        "name": "title",
        "envname": "RELAY_TITLE"
      },
      {
        "source": "payload",
        "name": "body",
        "envname": "RELAY_BODY"
      },
      {
        "source": "payload",
        "name": "type",
        "envname": "RELAY_TYPE"
      },
      {
        "source": "url",
        "name": "trigger",
        "envname": "RELAY_TRIGGER"
      }
    ]
  }
]
