{% set hosts = maps_addr | dict2items | sort(attribute='key') %}
{% macro endpoints(port, path) %}
{% for host in hosts %}
{% set role = host.key | regex_replace('^[a-z0-9]+-vm-', '') | regex_replace('-[0-9]+$', '') %}
    - targets: ["{{ host.value }}:{{ port }}"]
      path: {{ path }}
      scrape_interval: 60s
      labels:
        env: {{ host.key.split('-') | first }}
        role: {{ 'clt' if role.startswith('clt-') else role }}
{% if role.startswith('clt-') %}
        language: {{ role | regex_replace('^clt-', '') }}
{% endif %}
        instance: {{ host.key }}
        provider: vultr
        region: ewr
{% endfor %}
{% endmacro %}
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMStaticScrape
metadata:
  name: vultr-hosts-node
  annotations:
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  jobName: node
  targetEndpoints:
{{ endpoints(9100, '/metrics') }}
---
apiVersion: operator.victoriametrics.com/v1beta1
kind: VMStaticScrape
metadata:
  name: vultr-hosts-fluent-bit
  annotations:
    argocd.argoproj.io/sync-options: SkipDryRunOnMissingResource=true
spec:
  jobName: fluent-bit
  targetEndpoints:
{{ endpoints(2020, '/api/v2/metrics/prometheus') }}
