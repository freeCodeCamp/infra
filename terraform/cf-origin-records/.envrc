source_env ../..

if [ -d "$SECRETS_DIR" ]; then
  use_sops "$SECRETS_DIR/tfstate/.env.enc"
  if [ -f "$SECRETS_DIR/vultr/.env.enc" ]; then
    use_sops "$SECRETS_DIR/vultr/.env.enc"
  else
    log_error "missing $SECRETS_DIR/vultr/.env.enc: TF_VAR_state_passphrase is unset"
  fi
  if [ -f "$SECRETS_DIR/cloudflare/.env.enc" ]; then
    use_sops "$SECRETS_DIR/cloudflare/.env.enc"
  else
    log_error "missing $SECRETS_DIR/cloudflare/.env.enc: CLOUDFLARE_API_TOKEN is unset"
  fi
fi
