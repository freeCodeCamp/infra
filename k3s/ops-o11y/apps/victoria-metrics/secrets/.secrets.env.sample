# Credential schema for the vm-linode-sd Secret on ops-o11y. Tracked, always
# empty. Do not copy this file and fill it in: runbook 14 step 3 reads the
# value into the environment and never writes it to disk.
#
# The key name becomes the mounted filename, which the scrape config reads as
# /etc/vm/secrets/<KEY> — renaming a key breaks service discovery.
#
# Linode API token. Required scopes: linodes:read_only and ips:read_only.
# Mint at: https://cloud.linode.com/profile/tokens
LINODE_API_TOKEN=

# Hetzner Robot (unused until the bare-metal estate joins). Recreate the Secret
# with these two keys before uncommenting hetzner_sd_configs in the values.
# Distinct credential with its own revocation path at
# https://robot.hetzner.com — revoke it separately at teardown.
HETZNER_ROBOT_USER=
HETZNER_ROBOT_PASS=
