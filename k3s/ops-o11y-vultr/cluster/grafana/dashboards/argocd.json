{
  "uid": "fcc-argocd",
  "title": "Argo CD apps",
  "description": "Sync and health of each Argo CD Application, from the metrics of the Argo CD application controller. The cluster is the prometheus label that its vmagent adds.",
  "tags": ["kubernetes", "argocd"],
  "schemaVersion": 41,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/d/fcc-home",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Traffic",
      "type": "link",
      "url": "/d/fcc-traffic",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/fcc-fleet",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Alert history",
      "type": "link",
      "url": "/d/fcc-alerts",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Pods",
      "type": "link",
      "url": "/d/fcc-k8s-pods",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Argo CD apps",
      "type": "link",
      "url": "/d/fcc-argocd",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Logs (Explore)",
      "type": "link",
      "url": "/explore",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": {
          "query": "label_values(argocd_app_info, prometheus)",
          "refId": "cluster"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Applications now",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "max by (name, project, dest_namespace, sync_status, health_status, autosync_enabled) (argocd_app_info{prometheus=\"$cluster\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "health_status" },
            "properties": [
              { "id": "displayName", "value": "Health" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": { "color": "green" },
                      "Progressing": { "color": "blue" },
                      "Degraded": { "color": "red" },
                      "Missing": { "color": "red" },
                      "Unknown": { "color": "orange" },
                      "Suspended": { "color": "orange" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "sync_status" },
            "properties": [
              { "id": "displayName", "value": "Sync" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Synced": { "color": "green" },
                      "OutOfSync": { "color": "orange" },
                      "Unknown": { "color": "red" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "name" },
            "properties": [{ "id": "displayName", "value": "Application" }]
          },
          {
            "matcher": { "id": "byName", "options": "dest_namespace" },
            "properties": [{ "id": "displayName", "value": "Namespace" }]
          },
          {
            "matcher": { "id": "byName", "options": "autosync_enabled" },
            "properties": [{ "id": "displayName", "value": "Auto-sync" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Application", "desc": false }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": { "excludeByName": { "Time": true, "Value": true } }
        }
      ]
    },
    {
      "type": "state-timeline",
      "title": "Health over time",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "max by (name) ((argocd_app_info{prometheus=\"$cluster\", health_status=\"Healthy\"} * 0) or (argocd_app_info{prometheus=\"$cluster\", health_status=\"Progressing\"} * 0 + 1) or (argocd_app_info{prometheus=\"$cluster\", health_status!~\"Healthy|Progressing\"} * 0 + 2))",
          "legendFormat": "{{name}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Healthy", "color": "green" },
                "1": { "text": "Progressing", "color": "blue" },
                "2": { "text": "Degraded or other", "color": "red" }
              }
            }
          ],
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "type": "state-timeline",
      "title": "Sync over time",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "max by (name) ((argocd_app_info{prometheus=\"$cluster\", sync_status=\"Synced\"} * 0) or (argocd_app_info{prometheus=\"$cluster\", sync_status=\"OutOfSync\"} * 0 + 1) or (argocd_app_info{prometheus=\"$cluster\", sync_status!~\"Synced|OutOfSync\"} * 0 + 2))",
          "legendFormat": "{{name}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Synced", "color": "green" },
                "1": { "text": "OutOfSync", "color": "orange" },
                "2": { "text": "Unknown", "color": "red" }
              }
            }
          ],
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "type": "timeseries",
      "title": "Syncs per hour, by result",
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum by (name, phase) (increase(argocd_app_sync_total{prometheus=\"$cluster\"}[1h])) > 0",
          "legendFormat": "{{name}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 60 }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
