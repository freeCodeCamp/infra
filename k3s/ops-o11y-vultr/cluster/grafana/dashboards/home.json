{
  "uid": "fcc-home",
  "title": "Operator home",
  "description": "Is something wrong, and where do I look next?",
  "tags": ["home", "ops"],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [
    {
      "title": "Alert history",
      "type": "link",
      "url": "/d/fcc-alerts",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Pods",
      "type": "link",
      "url": "/d/fcc-k8s-pods",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Argo CD apps",
      "type": "link",
      "url": "/d/fcc-argocd",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Traffic",
      "type": "link",
      "url": "/d/fcc-traffic",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/fcc-fleet",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Silences",
      "type": "link",
      "url": "/alerting/silences?alertmanager=Alertmanager",
      "icon": "bolt"
    },
    {
      "title": "Logs (Explore)",
      "type": "link",
      "url": "/explore",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firing alerts",
      "description": "Alert names firing now, without Watchdog. One alert can fire for several targets. Click for the alert history.",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(count by (alertname) (ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"})) or vector(0)",
          "legendFormat": "Firing"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "links": [
            {
              "title": "Alert history",
              "url": "/d/fcc-alerts?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Silenced alerts",
      "description": "Alerts that Alertmanager holds back because of a silence. Click to see the silences.",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "max(alertmanager_alerts{state=\"suppressed\"}) or vector(0)",
          "legendFormat": "Silenced"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "blue", "value": 1 }
            ]
          },
          "links": [
            {
              "title": "Silences",
              "url": "/alerting/silences?alertmanager=Alertmanager"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Containers restarting",
      "description": "Containers that restarted in the last hour, in all clusters. Click for the Pods dashboard.",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(sum by (prometheus, namespace, container) (increase(kube_pod_container_status_restarts_total[1h])) > 0) or vector(0)",
          "legendFormat": "Restarting"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "links": [
            {
              "title": "Pods",
              "url": "/d/fcc-k8s-pods?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Argo CD apps not OK",
      "description": "Apps that are not Synced and Healthy, in all clusters. Click for the Argo CD apps dashboard.",
      "gridPos": { "x": 15, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(count by (prometheus, name) (last_over_time(argocd_app_info{health_status!=\"Healthy\"}[5m]) or last_over_time(argocd_app_info{sync_status!=\"Synced\"}[5m]))) or vector(0)",
          "legendFormat": "Not OK"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "links": [
            {
              "title": "Argo CD apps",
              "url": "/d/fcc-argocd?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failing probes",
      "description": "Blackbox probes that fail now. Click for the Traffic dashboard.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count(probe_success == 0) or vector(0)",
          "legendFormat": "Failing"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "links": [
            {
              "title": "Traffic",
              "url": "/d/fcc-traffic?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Firing now",
      "description": "One row per alert. Targets is how many series fire. Click an alert name for its history. Empty means no alert fires.",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "count by (alertname, severity) (ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "min by (alertname, severity) (ALERTS_FOR_STATE{alertname!=\"Watchdog\"}) * 1000 and on (alertname, severity) count by (alertname, severity) (ALERTS{alertstate=\"firing\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "Value #A": "Targets",
              "Value #B": "Since"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Alert" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "History of ${__value.raw}",
                    "url": "/d/fcc-alerts?var-alertname=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              { "id": "custom.width", "value": 110 },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "Critical",
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "text": "Warning",
                        "color": "orange",
                        "index": 1
                      },
                      "info": { "text": "Info", "color": "blue", "index": 2 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Targets" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "Since" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" },
              { "id": "custom.width", "value": 140 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Severity", "desc": false }],
        "footer": { "show": false }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Containers that restarted in the last hour",
      "description": "Grouped by container, so a pod that is replaced stays on one row. Last stop is why the container last stopped. Empty means no restarts.",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "round(sum by (prometheus, namespace, container) (increase(kube_pod_container_status_restarts_total[1h]))) > 0",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "max by (prometheus, namespace, container, reason) (kube_pod_container_status_last_terminated_reason) and on (prometheus, namespace, container) (sum by (prometheus, namespace, container) (increase(kube_pod_container_status_restarts_total[1h])) > 0)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value #B": true },
            "indexByName": {
              "prometheus": 0,
              "namespace": 1,
              "container": 2,
              "Value #A": 3,
              "reason": 4
            },
            "renameByName": {
              "prometheus": "Cluster",
              "namespace": "Namespace",
              "container": "Container",
              "Value #A": "Restarts",
              "reason": "Last stop"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Restarts" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pods in ${__data.fields.Namespace}",
                    "url": "/d/fcc-k8s-pods?var-cluster=${__data.fields.Cluster}&var-namespace=${__data.fields.Namespace}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Last stop" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OOMKilled": { "color": "red", "index": 0 },
                      "Error": { "color": "orange", "index": 1 },
                      "Completed": { "color": "text", "index": 2 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Restarts", "desc": true }],
        "footer": { "show": false }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Argo CD apps that are not Synced and Healthy",
      "description": "Empty means every app is Synced and Healthy.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "max by (prometheus, name, health_status, sync_status) (argocd_app_info{health_status!=\"Healthy\"} or argocd_app_info{sync_status!=\"Synced\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true },
            "indexByName": {
              "prometheus": 0,
              "name": 1,
              "health_status": 2,
              "sync_status": 3
            },
            "renameByName": {
              "prometheus": "Cluster",
              "name": "Application",
              "health_status": "Health",
              "sync_status": "Sync"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Application" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Argo CD apps",
                    "url": "/d/fcc-argocd?var-cluster=${__data.fields.Cluster}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Health" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": { "color": "green", "index": 0 },
                      "Progressing": { "color": "blue", "index": 1 },
                      "Degraded": { "color": "red", "index": 2 },
                      "Missing": { "color": "orange", "index": 3 },
                      "Suspended": { "color": "purple", "index": 4 },
                      "Unknown": { "color": "text", "index": 5 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Sync" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Synced": { "color": "green", "index": 0 },
                      "OutOfSync": { "color": "orange", "index": 1 },
                      "Unknown": { "color": "text", "index": 2 }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Memory closest to the limit",
      "description": "Working memory against the memory limit, now, for the 8 containers nearest their limit. At 100% the kernel kills the container (OOMKilled).",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sort_desc(topk(8, max by (prometheus, namespace, container) (container_memory_working_set_bytes{container!=\"\", container!=\"POD\"}) / on (prometheus, namespace, container) max by (prometheus, namespace, container) (kube_pod_container_resource_limits{resource=\"memory\"})))",
          "legendFormat": "{{namespace}}/{{container}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "left",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 24
      }
    },
    {
      "id": 10,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "[Active notifications](/alerting/groups?alertmanager=Alertmanager) · [Silences](/alerting/silences?alertmanager=Alertmanager) · [Routes and receivers](/alerting/routes?alertmanager=Alertmanager) · [Alert rules](/alerting/list) · [VictoriaMetrics components](/dashboards?tag=victoriametrics) · [Node Exporter Full](/d/rYdddlPWk) · [Runbook 19](https://github.com/freeCodeCamp/infra/blob/main/docs/runbooks/19-o11y-alerts.md) · Argo CD: [ops-vm-o11y-1:30081](http://ops-vm-o11y-1:30081) or the Tailscale Service `svc:argocd-o11y`"
      }
    }
  ]
}
